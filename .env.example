VERBATIM_DATABASE_URL=jdbc:postgresql://localhost:5432/verbatim
VERBATIM_DATABASE_USER=verbatim
VERBATIM_DATABASE_PASSWORD=verbatim
VERBATIM_REDIS_HOST=localhost
VERBATIM_REDIS_PORT=6379
VERBATIM_PORT=8081
VERBATIM_DATA_DIR=../.verbatim-data
VERBATIM_CODEX_EXECUTABLE=codex
VERBATIM_CODEX_ENABLED=true
VERBATIM_CODEX_ALLOW_FALLBACK=true
VERBATIM_CODEX_TIMEOUT_SECONDS=300
VERBATIM_OCR_SCHEMA=../schemas/ocr-result.schema.json
VERBATIM_VISUAL_REVIEW_SCHEMA=../schemas/visual-review-result.schema.json
VERBATIM_VISUAL_REVIEW_ENABLED=true
VERBATIM_VISUAL_REVIEW_MAX_PAGES=20
